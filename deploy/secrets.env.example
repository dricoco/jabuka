# Copy to deploy/secrets.env (gitignored, never commit it) and set a real WPA2 passphrase:
#   cp deploy/secrets.env.example deploy/secrets.env && chmod 600 deploy/secrets.env
# JABUKA_PSK: 8 to 63 printable ASCII characters. provision.sh refuses this example value on a
# real run, and never prints the passphrase.
JABUKA_PSK=change-me-8-to-63-chars
