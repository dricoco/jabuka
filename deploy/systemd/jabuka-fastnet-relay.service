# Jabuka receive-only Fastnet relay for Plan B (fastnet2ip). Manual start only: it is pulled in by
# fastnet2ip.service (BindsTo=) and stops again when fastnet2ip stops (StopWhenUnneeded=). No
# [Install] section, so it can never be enabled at boot.
#
# It opens /dev/fastnet exactly like the ingest (O_RDONLY, line control refused, exclusive lock) and
# copies the bytes into a pty linked at /run/jabuka-relay/fastnet-ro. fastnet2ip reads that pty as
# the unprivileged jabuka user without the dialout group: it cannot open /dev/fastnet, and anything
# it writes into the pty is read back by the relay, discarded and logged, never sent on the wire.
#
# Conflicts=jabuka-ingest-fastnet.service: only one process may own the port (exclusive lock).
# StartLimitIntervalSec=0: a crash loop must not leave Plan B permanently dead (systemd's default
# is 5 starts in 10 s, then failed), the same as the main units.
# RestartMode=direct: an auto-restart goes straight back to activating without passing through
# inactive/failed, so fastnet2ip's BindsTo= never stops Plan B on a single relay crash and
# StopWhenUnneeded= never stops the restarted relay (review WR-06). Needs systemd >= 254
# (Trixie ships 257).

[Unit]
Description=Jabuka receive-only Fastnet relay for Plan B (fastnet2ip)
Documentation=file:///opt/jabuka/PI-SETUP.md
Conflicts=jabuka-ingest-fastnet.service
StopWhenUnneeded=yes
StartLimitIntervalSec=0

[Service]
Type=notify
User=jabuka
Group=jabuka
SupplementaryGroups=dialout
RuntimeDirectory=jabuka-relay
RuntimeDirectoryMode=0750
ExecStart=/opt/jabuka/venv/bin/jabuka-fastnet-relay --device /dev/fastnet --link /run/jabuka-relay/fastnet-ro --log-level INFO
Restart=on-failure
RestartMode=direct
RestartSec=2
WatchdogSec=30
OOMScoreAdjust=-700
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
