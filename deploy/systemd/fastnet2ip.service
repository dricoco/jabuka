# fastnet2ip: manual PLAN B only. It is NOT enabled at boot, and this unit has no [Install]
# section, so `systemctl enable` cannot wire it into boot by accident.
#
# Use it only when the Jabuka ingest is unusable: OpenCPN on a laptop on the jabuka AP listens on
# UDP 2002 for the NMEA 0183 sentences broadcast here.
#   start:   sudo systemctl start fastnet2ip        (Conflicts= stops jabuka-ingest-fastnet)
#   return:  sudo systemctl start jabuka-ingest-fastnet   (Conflicts= stops fastnet2ip)
#
# Installed with `pipx install --global fastnet2ip==3.3.1` (lands in /usr/local/bin).
# It runs as root and pyserial opens the port read/write (/dev/fastnet is 0640 root:dialout).
# The upstream source at 3.3.1 has no serial write call (checked by grep during planning,
# 2026-11-06), but the ingest's kernel-enforced O_RDONLY guarantee does not apply here.
#
# Upstream's unit binds to the ttyUSB0 device; that is dropped here (it is started by hand).

[Unit]
Description=fastnet2ip Plan B (Fastnet to NMEA 0183 on UDP 2002), manual start only
Conflicts=jabuka-ingest-fastnet.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/fastnet2ip --output nmea0183 --serial /dev/fastnet --udp-port 2002 --host 10.42.0.255 --log-level WARNING
Restart=on-failure
RestartSec=5
OOMScoreAdjust=-700
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=fastnet2ip
