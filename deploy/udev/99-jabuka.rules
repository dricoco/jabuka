# Jabuka stable device names. Installed to /etc/udev/rules.d/ by deploy/provision.sh.
# Confirm the VID:PID pairs with `lsusb` on the Pi (deploy/PI-SETUP.md section 2).
#
# DTECH USB RS422/485 (FTDI FT232R, 0403:6001) -> /dev/fastnet.
# MODE 0640 root:dialout: the group can only READ, so the jabuka user (in dialout) cannot open the
# B&G bus for writing even by mistake. ModemManager is told to ignore it.
# If several FT232 adapters may be plugged in, pin this one by serial number: add
#   ATTRS{serial}=="<DTECH serial>"
# to the rule (read it with `udevadm info -a -n /dev/ttyUSB0` on the Pi).
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="fastnet", GROUP="dialout", MODE="0640", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="systemd"

# VK-162 GPS (u-blox 7, 1546:01a7) -> /dev/gps, opened only by gpsd (DEVICES="/dev/gps").
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a7", SYMLINK+="gps", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="systemd"
